# ==============================================================================
# FRONTEND - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# File: frontend/.env.development (or frontend/.env)
# ==============================================================================

# 1. BACKEND API URL (Where the frontend sends REST API requests)
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
# Keep as '/api'. Vite's dev server will proxy '/api' requests to your local
# backend running at http://localhost:5001.
# (Alternatively, you can provide the direct backend link: http://localhost:5001/api)
VITE_API_BASE_URL=/api

# 2. VITE PROXY TARGET URL
# ------------------------------------------------------------------------------
# This tells Vite where your local backend server is running:
VITE_BACKEND_TARGET=http://localhost:5001

# 3. APPLICATION BRANDING
# ------------------------------------------------------------------------------
VITE_APP_NAME="Hospital Dietary Department Meal Planning Portal (Local)"
