# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES REFERENCE (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# For Vercel production deployment:
#   Add these in Vercel Dashboard -> Your Frontend Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API URL (VITE_API_BASE_URL)
# ------------------------------------------------------------------------------
# Which link should you give here?
#
# - FOR LOCAL DEVELOPMENT:
#   Give: /api
#   (Vite's proxy in vite.config.ts will forward all /api requests to http://localhost:5001)
#   Or directly: http://localhost:5001/api
#
# - FOR PRODUCTION DEPLOYMENT (Vercel):
#   Give your deployed Backend service URL + /api
#   Example: https://hospital-dietary-backend.vercel.app/api
#   (If using a unified domain with reverse proxy, you can keep it as '/api')
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# 2. LOCAL BACKEND PROXY TARGET (VITE_BACKEND_TARGET)
# ------------------------------------------------------------------------------
# Which link should you give here?
# Only needed for local dev server (npm run dev):
# Default: http://localhost:5001
# ------------------------------------------------------------------------------
VITE_BACKEND_TARGET=http://localhost:5001

# ------------------------------------------------------------------------------
# 3. APPLICATION NAME (VITE_APP_NAME)
# ------------------------------------------------------------------------------
VITE_APP_NAME="Hospital Dietary Department Portal"
