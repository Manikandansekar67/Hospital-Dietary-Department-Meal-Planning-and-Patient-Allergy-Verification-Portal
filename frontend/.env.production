# ==============================================================================
# FRONTEND - PRODUCTION ENVIRONMENT CONFIGURATION
# File: frontend/.env.production
# NOTE: In Vercel, set these variables in: Project Settings -> Environment Variables
# ==============================================================================

# 1. BACKEND API URL (Where the frontend sends REST API requests)
# ------------------------------------------------------------------------------
# PRODUCTION ON VERCEL:
# - Scenario A (Separate Vercel projects for Frontend & Backend):
#   Set this to your live backend Vercel URL with the /api prefix:
#   Example: https://hospital-dietary-backend.vercel.app/api
#
# - Scenario B (Frontend and Backend under the same custom domain or rewrite proxy):
#   Leave as: /api
VITE_API_BASE_URL=https://your-backend-api.vercel.app/api

# 2. APPLICATION BRANDING
# ------------------------------------------------------------------------------
VITE_APP_NAME="Hospital Dietary Department Meal Planning and Patient Allergy Verification Portal"
