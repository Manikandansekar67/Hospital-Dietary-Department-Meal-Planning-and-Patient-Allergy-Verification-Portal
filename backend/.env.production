# ==============================================================================
# BACKEND - PRODUCTION ENVIRONMENT CONFIGURATION
# File: backend/.env.production
# NOTE: In Vercel, set these in: Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. DATABASE URL (MONGODB_URI)
# ------------------------------------------------------------------------------
# Which link should you give here?
# Give your live MongoDB Atlas connection string.
# How to get it from MongoDB Atlas:
#   1. Go to MongoDB Atlas (cloud.mongodb.com) -> Database Deployments
#   2. Click "Connect" -> "Drivers" (Node.js)
#   3. Copy the URI and replace <username> and <password> with your DB user credentials
#   Format:
#   mongodb+srv://<username>:<password>@cluster0.kzghsgv.mongodb.net/HDP?retryWrites=true&w=majority
#
# NOTE: Ensure Network Access in MongoDB Atlas has "0.0.0.0/0" allowed so Vercel can connect!
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://manikandan:manikandan@cluster0.kzghsgv.mongodb.net/HDP?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. FRONTEND URL & CORS ALLOWED ORIGINS (FRONTEND_URL / CORS_ORIGIN)
# ------------------------------------------------------------------------------
# Which link should you give here?
# - FRONTEND_URL: Give your live Frontend Vercel deployment link
#   Example: https://hospital-dietary-portal.vercel.app
#
# - CORS_ORIGIN:
#   Set to '*' to allow requests from any frontend domain,
#   OR specify your exact frontend domain: https://hospital-dietary-portal.vercel.app
# ------------------------------------------------------------------------------
FRONTEND_URL=https://hospital-dietary-portal.vercel.app
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECRET (JWT_SECRET)
# ------------------------------------------------------------------------------
# Set a strong, randomly generated secret (at least 32 characters)
# Example: Generate via terminal with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_SECRET=production-super-secret-jwt-key-minimum-32-characters-hospital-portal
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 5. SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
