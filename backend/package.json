{
  "name": "hospital-dietary-backend",
  "version": "1.0.0",
  "description": "Hospital Dietary Department Meal Planning and Patient Allergy Verification Portal - Backend REST API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:seed": "tsx scripts/seed.ts",
    "db:migrate": "tsx scripts/migrate-from-postgres.ts",
    "test:db": "tsx tests/database.test.ts",
    "test:api": "tsx tests/api.test.ts",
    "test": "tsx tests/database.test.ts && tsx tests/api.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.13.0",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
