# ==============================================================================
# BACKEND - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# File: backend/.env.development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER PORT & ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE URL (MONGODB_URI)
# ------------------------------------------------------------------------------
# Which link should you give here?
# - For MongoDB Atlas Cloud Database:
#   Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<database_name>?appName=Cluster0
#   Example: mongodb+srv://manikandan:manikandan@cluster0.kzghsgv.mongodb.net/HDP?appName=Cluster0
#
# - Or For Local MongoDB Community Server:
#   Format: mongodb://localhost:27017/hospital_dietary_db
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://manikandan:manikandan@cluster0.kzghsgv.mongodb.net/HDP?appName=Cluster0

# ------------------------------------------------------------------------------
# 3. FRONTEND URL & CORS ALLOWED ORIGINS (FRONTEND_URL / CORS_ORIGIN)
# ------------------------------------------------------------------------------
# Which link should you give here?
# - In local development, the Vite frontend runs at: http://localhost:3000
# - CORS_ORIGIN: Use '*' to allow all local origins, or 'http://localhost:3000'
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Any secret key string (minimum 32 characters recommended)
JWT_SECRET=hospital-dietary-super-secret-jwt-key-2026-local-development
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 5. SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
