# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES REFERENCE (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# For Vercel production deployment:
#   Add these variables in Vercel Dashboard -> Your Backend Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER PORT & ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. DATABASE URL (MONGODB_URI)
# ------------------------------------------------------------------------------
# Which link should you give here?
#
# LOCAL DEV:
#   mongodb+srv://<username>:<password>@cluster0.kzghsgv.mongodb.net/HDP?appName=Cluster0
#   (or local MongoDB: mongodb://localhost:27017/hospital_portal)
#
# PRODUCTION ON VERCEL:
#   mongodb+srv://<username>:<password>@cluster0.kzghsgv.mongodb.net/HDP?retryWrites=true&w=majority
#
# IMPORTANT: In MongoDB Atlas (cloud.mongodb.com), go to Network Access -> Add IP Address
# -> Choose "Allow Access From Anywhere" (0.0.0.0/0) so Vercel serverless functions can connect.
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/HDP?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. FRONTEND URL & CORS ORIGIN (FRONTEND_URL / CORS_ORIGIN)
# ------------------------------------------------------------------------------
# Which link should you give here?
#
# LOCAL DEV:
#   FRONTEND_URL=http://localhost:3000
#   CORS_ORIGIN=*
#
# PRODUCTION ON VERCEL:
#   FRONTEND_URL=https://your-frontend-project.vercel.app
#   CORS_ORIGIN=* (or set exact: https://your-frontend-project.vercel.app)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECRET (JWT_SECRET)
# ------------------------------------------------------------------------------
# Required for signing auth tokens (minimum 32 characters for security)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 5. SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500