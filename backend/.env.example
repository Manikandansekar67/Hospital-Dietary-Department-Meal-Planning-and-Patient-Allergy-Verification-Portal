PORT=5001
NODE_ENV=production
# MongoDB Atlas Connection String (Required in Vercel Environment Variables)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hospital_portal?retryWrites=true&w=majority
# JWT Secret Key (Required: Minimum 32 characters for security)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h
# CORS Allowed Origins (* allows all, or comma-separated domains like https://your-domain.vercel.app)
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500